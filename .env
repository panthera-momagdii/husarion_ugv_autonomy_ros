RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
CYCLONE_DDS_URI=file:///config/cyclonedds.xml

# Gazebo world. Bundled options (inside image):
#   /ros2_ws/install/husarion_gz_worlds/share/husarion_gz_worlds/worlds/husarion_world.sdf  (default)
#   /ros2_ws/install/husarion_gz_worlds/share/husarion_gz_worlds/worlds/husarion_office.sdf
#   /ros2_ws/install/husarion_gz_worlds/share/husarion_gz_worlds/worlds/sonoma_raceway.sdf
#   /ros2_ws/install/husarion_gz_worlds/share/husarion_gz_worlds/worlds/empty_with_plugins.sdf
# For a custom SDF, drop the file in ./worlds/ and set GZ_WORLD=/worlds/<file>.sdf
#GZ_WORLD=/ros2_ws/install/husarion_gz_worlds/share/husarion_gz_worlds/worlds/sonoma_raceway.sdf
GZ_WORLD=/ros2_ws/install/husarion_gz_worlds/share/husarion_gz_worlds/worlds/husarion_world.sdf

# Robot namespace — applied uniformly across compose files, GLIM frame IDs,
# and Nav2 params. Change in one place; all containers pick it up.
ROBOT_NAMESPACE=panther

# GLIM config directory mounted into the glim container at /glim/config.
# Default points at the sibling repo /root/slam/glim/config; override per host
# (e.g. when deploying on hardware) by setting an absolute path here.
GLIM_CONFIG_DIR=../glim/config
